---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
import { roadmap, roadmapPages } from '../../data/roadmap';
import type { RoadmapCategory, RoadmapItem } from '../../data/roadmap';

/**
 * One dynamic route, two page kinds:
 *  - /services/<item-slug>/     — a workflow one-pager (kind: 'item')
 *  - /services/<category-slug>/ — a category page listing its workflows
 *    (kind: 'category'), linked from the nav mega-menu and the footer.
 * Category slugs and item slugs are disjoint, so the params never collide.
 */
export function getStaticPaths() {
  const itemPaths = roadmapPages.map(({ category, item }) => ({
    params: { slug: item.slug },
    props: { kind: 'item' as const, category, item },
  }));
  const categoryPaths = roadmap.map((category) => ({
    params: { slug: category.slug },
    props: { kind: 'category' as const, category },
  }));
  return [...itemPaths, ...categoryPaths];
}

interface Props {
  kind: 'item' | 'category';
  category: RoadmapCategory;
  item?: RoadmapItem;
}

const { kind, category, item } = Astro.props;
const isCategory = kind === 'category';

const isWebsiteSource = !isCategory && item?.slug === 'website-builder';
const pageTitle = isCategory
  ? `${category.name} - Workflow discovery - Solborne & Co.`
  : `${isWebsiteSource ? 'Client-owned website source' : item!.name} - Solborne & Co.`;
const pageDescription = isWebsiteSource
  ? 'Review your public business facts and download free website HTML plus an ownership README. Hosting, domains and future changes are separate arrangements.'
  : `${isCategory ? category.name : item!.name}: a topic for one-workflow discovery. Scope, availability and any implementation are agreed separately.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <PageIntro eyebrow={isCategory ? 'Workflow discovery' : category.name} title={isWebsiteSource ? 'Client-owned website source' : isCategory ? category.name : item!.name}>
    <p>{pageDescription}</p>
  </PageIntro>
  {isCategory ? (
    <Section label="Discovery topics">
      <ul class="cat-list" role="list">
        {category.items.map(entry => (
          <li class="cat-item">
            <div class="cat-text">
              {entry.slug ? <a class="cat-name cat-link" href={`/services/${entry.slug}/`}>{entry.name}</a> : <p class="cat-name">{entry.name}</p>}
            </div>
            <p class="cat-tag">Discovery topic</p>
          </li>
        ))}
      </ul>
      <p class="cat-note">Choose one task and describe the tools, people and result involved. Availability, integrations and delivery scope need confirmation before implementation or AI activation.</p>
    </Section>
  ) : isWebsiteSource ? (
    <Section label="Website ownership" title="Your public facts. Your files.">
      <p class="prose">The Walk follows your business story through reviewed answers and follow-up questions. You choose the public fields and approve any selected research suggestions before generating a static website preview.</p>
      <p class="prose">The free deliverable is HTML plus an ownership README that you can download and edit. Hosting, domain registration or renewal, maintenance and future changes require separate arrangements.</p>
    </Section>
  ) : (
    <Section label="Define the task" title="Start with one workflow.">
      <p class="prose">Describe how this task is done today, your current tools and the result you want. Discovery establishes a useful scope and checks what is feasible for your business.</p>
      <p class="prose">Any automation, AI service or paid work requires separately agreed terms, suitable integrations and approval before activation. This topic page does not establish a working integration for your business.</p>
    </Section>
  )}
  <Section label="Next step">
    <div class="cta-row">
      <Button href={isWebsiteSource ? '/walk/' : '/contact/'}>{isWebsiteSource ? 'Explore the Walk' : 'Business enquiry details'}</Button>
      <Button href="/services/" variant="ghost">Website source and discovery</Button>
    </div>
  </Section>
</BaseLayout>

<style>
  /* ---- Category page: hairline workflow rows (mirrors the hub catalog) ---- */
  .count {
    color: var(--color-steel);
  }

  .cat-list {
    list-style: none;
    max-width: 50rem;
  }

  .cat-item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-md);
    align-items: baseline;
    padding: 0.875rem 0;
    border-bottom: var(--border-hairline);
  }

  .cat-item:last-child {
    border-bottom: none;
  }

  .cat-name {
    font-weight: var(--weight-body-medium);
    font-size: var(--text-body);
    color: var(--color-ink);
  }

  .cat-link {
    display: inline-block;
    text-decoration: none;
    color: var(--color-ink);
    border-bottom: 1px solid transparent;
    transition: color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .cat-link span {
    color: var(--color-steel);
  }

  .cat-link:hover {
    color: var(--color-steel);
    border-bottom-color: var(--color-steel);
  }

  .cat-blurb {
    font-size: var(--text-body-sm);
    line-height: var(--leading-tight);
    color: var(--color-body);
    margin-top: 0.25rem;
    max-width: 62ch;
  }

  .cat-tag {
    font-family: var(--font-mono);
    font-size: var(--text-tag);
    font-weight: var(--weight-mono);
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    color: var(--color-stone);
    white-space: nowrap;
  }

  .cat-note {
    margin-top: var(--space-md);
    font-size: var(--text-caption);
    line-height: var(--leading-tight);
    color: var(--color-body);
    max-width: 60ch;
  }

  @media (max-width: 760px) {
    .cat-item {
      grid-template-columns: 1fr;
      gap: 0.375rem;
    }
  }

  /* ---- Ready-to-run status panel ----
     Deliberately lighter than the live-services flagship surface: a plain
     panel, no amber fill, so an individually-linkable catalog item never
     visually outranks the staffed catalog on /services/. */
  .ready-panel {
    max-width: 50rem;
    background: var(--color-panel);
    border: var(--border-hairline);
    border-radius: var(--radius-card);
    padding: clamp(1.75rem, 1rem + 3vw, 2.75rem) clamp(1.25rem, 0.5rem + 3vw, 2.5rem);
  }

  .ready-tag {
    font-family: var(--font-mono);
    font-size: var(--text-tag);
    font-weight: var(--weight-mono-medium);
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    color: var(--color-positive);
    margin-bottom: var(--space-sm);
  }

  .ready-line {
    font-family: var(--font-display);
    font-weight: var(--weight-body-medium);
    font-size: var(--text-lede);
    line-height: var(--leading-lede);
    color: var(--color-ink);
    max-width: 46ch;
  }

  .ready-note {
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
    color: var(--color-body);
    max-width: var(--width-measure);
    margin-top: var(--space-sm);
  }

  /* ---- Prose blocks ---- */
  .prose-lede {
    max-width: var(--width-measure);
    font-size: var(--text-body-lg);
    line-height: var(--leading-body);
    color: var(--color-body-strong);
  }

  .prose {
    max-width: var(--width-measure);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-body-strong);
  }

  /* ---- Benefit + evidence tier ---- */
  .benefit {
    max-width: var(--width-measure);
  }

  .benefit-claim {
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-body-strong);
    margin-bottom: var(--space-md);
  }

  .tier-card {
    background: var(--color-panel);
    border: var(--border-hairline);
    border-left: 3px solid var(--color-steel);
    border-radius: var(--radius-card);
    padding: 1.375rem var(--space-md);
  }

  .tier-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-tag);
    font-weight: var(--weight-mono);
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    color: var(--color-stone);
    margin-bottom: 0.5rem;
  }

  .tier-label {
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-mono-medium);
    color: var(--color-ink);
    margin-bottom: 0.5rem;
  }

  .tier-note {
    font-size: var(--text-body-sm);
    line-height: var(--leading-tight);
    color: var(--color-body);
    margin-bottom: 0.75rem;
  }

  .tier-source {
    font-size: var(--text-caption);
    line-height: var(--leading-tight);
    color: var(--color-body);
  }

  .tier-source-label {
    font-family: var(--font-mono);
    font-size: var(--text-tag);
    font-weight: var(--weight-mono);
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    color: var(--color-stone);
  }

  .benefit-disclaimer {
    font-size: var(--text-caption);
    line-height: var(--leading-body);
    color: var(--color-body);
    margin-top: var(--space-md);
    max-width: 60ch;
  }

  /* ---- CTA row ---- */
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: center;
    margin-top: var(--space-2xs);
  }
</style>
