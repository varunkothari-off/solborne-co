---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Section from '../components/Section.astro';
import { enquiryContact } from '../data/site';
const pageTitle = 'Business enquiries - Solborne & Co.';
const pageDescription = 'Discuss a client-owned website or one business workflow. Share your business, current tools and the result you need; agree any further help separately.';
---
<BaseLayout title={pageTitle} description={pageDescription}>
  <PageIntro eyebrow="Business enquiries" title="What would make your work easier?">
    <p>Tell us about a website you want to own, or one repetitive business task you want to improve. Start with a clear goal; any paid work or AI service requires a separate scope and agreement.</p>
  </PageIntro>
  <Section label="A useful first message" title="One workflow. Your context.">
    <ul>
      <li>Your business name and public website, if you have one.</li>
      <li>The task you want to improve and who does it today.</li>
      <li>Your current tools and the result you want.</li>
      <li>A business email where Varun can reply.</li>
    </ul>
    <p>Share only what is needed for the enquiry. Leave out passwords, financial records and private customer information.</p>
    {enquiryContact.verified ? (
      <p><a href={`mailto:${enquiryContact.email}`}>Email your business enquiry</a></p>
    ) : (
      <p role="status">Online enquiries are temporarily unavailable. This page cannot receive your message yet.</p>
    )}
  </Section>
</BaseLayout>