---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import ConfidenceBar from '../components/ConfidenceBar.astro';
import { caseStudies } from '../data/case-studies';
import { site } from '../data/site';
import { flow } from '../data/flow';
import { walk } from '../data/walk';

const pageTitle = `${site.name} — ${site.tagline}`;
const pageDescription = 'Client-owned website source for small firms, solo practices and growing brands, plus practical discovery for one business workflow.';

/** Home highlights: the first three stages of THE FLOW (it is one journey,
    not a menu of services — the full flow lives on /services/). */
const highlights = flow.slice(0, 3);

const steps = [
  { num: '01', name: 'Tell your story', text: 'Speak or type in your own words. Review each answer before moving on; follow-ups are based on what you shared.' },
  { num: '02', name: 'Choose public facts', text: 'Decide which business details, services and contact options belong on your website. Research suggestions require permission and confirmation.' },
  { num: '03', name: 'Review your website', text: 'Check the generated preview and edit the public fields before downloading. Your private interview is not automatically published.' },
  { num: '04', name: 'Keep the source', text: 'Download your HTML and ownership README. Hosting, domain renewals and any further implementation are separate arrangements.' },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  {/* No eyebrow on the home masthead — the headline carries it alone. */}
  <PageIntro lines={['Every business deserves a webspace.', 'You keep the source.']}>
    <p>Tell your business story, choose the facts you want public, and keep the source files for your website. Solborne &amp; Co. also helps you frame one business workflow for practical discovery: the task, your current tools and the result you need.</p>
  </PageIntro>

  <div class="wrap">
    <div class="cta-row">
      <Button href={walk.path}>Begin the walk</Button>
      <Button href="/contact/" variant="ghost">Discuss one workflow</Button>
    </div>
  </div>

  <Section label="How it starts" title="From your story to website files">
    <div class="service-grid">
      {
        highlights.map((stage, i) => (
          <article class="card">
            <h3>{stage.name}</h3>
            <p class="price-note">{stage.tag ? stage.tag : `Stage ${i + 1}`}</p>
            <p class="summary">{stage.blurb}</p>
          </article>
        ))
      }
    </div>
    <p class="more"><a href="/services/">Website ownership and workflow discovery &rarr;</a></p>
  </Section>

  <Section label="How we work" title="Your guide, not your stand-in">
    <p class="section-lead">
      We don't take the wheel of your business. We help you read the road, then hand
      you the reins — the same care at every price.
    </p>
    <div class="how-grid">
      <ol class="steps" role="list">
        {
          steps.map((step) => (
            <li class="step">
              <span class="step-num" aria-hidden="true">{step.num}</span>
              <div>
                <h3>{step.name}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="demo">
        <ConfidenceBar
          question="Should we use AI in our intake process?"
          answer="Short answer: yes, for triage — not for the final decision."
          confidence={78}
          note="The gap is your data volume; we'd revisit above 10,000 tickets a month."
        />
        <p class="demo-note">Illustrative explanation of uncertainty; this is not a client result or measured confidence for your business.</p>
      </div>
    </div>
    <p class="more"><a href="/approach/">Our approach &rarr;</a></p>
  </Section>

  {
    /* CASE STUDIES — hidden while the write-ups are placeholders. Flip
       `showCaseStudies` in src/data/site.ts to bring the section back. */
    site.showCaseStudies && (
      <Section label="Case studies" title="Write-ups in preparation">
        <div class="case-grid">
          {caseStudies.map((cs) => (
            <article class="case-card">
              <p class="tag">In preparation</p>
              <h3>
                <a href={`/case-studies/${cs.slug}/`}>{cs.name}</a>
              </h3>
              <p class="teaser">{cs.teaser}</p>
            </article>
          ))}
        </div>
      </Section>
    )
  }

  <section class="cta-band" aria-label="Start a conversation" data-reveal>
    <div class="wrap">
      <div class="stage">
        <p class="pull">Start with your business story. Review your public facts and keep your free website source files.</p>
        <div class="cta-row cta-row--stage">
          <Button href={walk.path}>Begin the walk</Button>
          <Button href="/contact/" variant="ghost">Discuss one workflow</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Masthead CTA row ---- */
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs) var(--space-sm);
  }

  .wrap > .cta-row {
    margin: -1.25rem 0 4.25rem;
  }

  /* ---- What we do: service highlights ---- */
  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }

  .card {
    background: var(--color-panel);
    border: var(--border-hairline);
    border-radius: var(--radius-card);
    padding: 1.5rem 1.5rem 1.625rem;
  }

  /* The single permitted amber surface — the flagship card only. */
  .card.flagship {
    background: var(--color-bearing-wash);
  }

  .card h3 {
    margin-bottom: 0.625rem;
  }

  .price-note {
    font-family: var(--font-mono);
    font-size: var(--text-tag);
    font-weight: var(--weight-mono);
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    color: var(--color-stone);
    margin-bottom: 0.875rem;
  }

  .summary {
    font-size: var(--text-body-sm);
    line-height: var(--leading-tight);
    color: var(--color-body);
  }

  .more {
    margin-top: var(--space-md);
    font-size: var(--text-body-sm);
  }

  /* ---- How we work ---- */
  .section-lead {
    max-width: var(--width-intro);
    color: var(--color-body);
    margin-bottom: var(--space-lg);
  }

  .how-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .steps {
    list-style: none;
    display: grid;
    gap: var(--space-md);
  }

  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-sm);
  }

  .step-num {
    font-family: var(--font-mono);
    font-weight: var(--weight-mono-medium);
    font-size: var(--text-caption);
    color: var(--color-steel);
    padding-top: 0.25rem;
  }

  .step h3 {
    margin-bottom: 0.375rem;
  }

  .step p {
    font-size: var(--text-body-sm);
    line-height: var(--leading-tight);
    color: var(--color-body);
  }

  .demo-note {
    margin-top: var(--space-xs);
    font-size: var(--text-caption);
    color: var(--color-stone);
  }

  /* ---- Recent work ---- */
  .case-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }

  .case-card {
    background: var(--color-panel);
    border: var(--border-hairline);
    border-radius: var(--radius-card);
    padding: 1.5rem 1.5rem 1.625rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: var(--text-tag);
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    color: var(--color-stone);
    margin-bottom: 0.875rem;
  }

  .case-card h3 {
    margin-bottom: 0.625rem;
  }

  .case-card h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .case-card h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-steel);
    text-underline-offset: 3px;
  }

  .teaser {
    font-size: var(--text-body-sm);
    line-height: var(--leading-tight);
    color: var(--color-body);
  }

  /* ---- Final CTA band ---- */
  .cta-band {
    padding: var(--space-lg) 0 var(--space-2xl);
  }

  .stage {
    background: var(--color-panel);
    border: var(--border-hairline);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-stage);
    padding: clamp(2.5rem, 2rem + 2vw, 3.75rem) var(--space-lg);
    text-align: center;
  }

  .pull {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--text-h2);
    line-height: var(--leading-heading);
    color: var(--color-ink);
    max-width: 24ch;
    margin: 0 auto;
  }

  .cta-row--stage {
    margin-top: var(--space-lg);
  }

  /* ---- Responsive ---- */
  @media (max-width: 860px) {
    .how-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }

  @media (max-width: 760px) {
    .service-grid,
    .case-grid {
      grid-template-columns: 1fr;
    }

    .stage {
      padding-inline: var(--space-md);
    }
  }
</style>
