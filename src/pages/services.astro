---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import { flow } from '../data/flow';
import { walk } from '../data/walk';
import { roadmap, roadmapCount } from '../data/roadmap';

const pageTitle = 'Services — Solborne & Co.';
const pageDescription = 'Client-owned website source and discovery for one business workflow. Review your public facts, keep your website files and agree any further help separately.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <PageIntro eyebrow="Services" title="Your webspace. A clearer next step.">
    <p>Start with your business story and the facts you want public. The Walk leads to a free static website preview and source files you control.</p>
    <p>For business workflow discovery, describe one task, the tools you use and the result you need. Hosting, implementation and any AI lead service require a separate scope and agreement.</p>
  </PageIntro>

  <Section label="The flow" title="How it flows, start to finish." id="flow">
    <!-- ============================================================
         PRICING GATE (deliberate): no price figures on the site.
         Stages carry Free/Paid tags only; WHERE payment begins in
         the middle of the flow is an open founder decision, so the
         middle stages carry no tag at all.
         ============================================================ -->
    <ol class="flow" role="list">
      {
        flow.map((stage, i) => (
          <li class="fstage">
            <span class="fstage-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="fstage-body">
              <h3 class="fstage-name">
                {stage.href ? <a href={stage.href}>{stage.name}</a> : stage.name}
                {stage.tag && <span class="fstage-tag">{stage.tag}</span>}
              </h3>
              <p class="fstage-blurb">{stage.blurb}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <div class="cta-row">
      <Button href={walk.path}>Begin the walk</Button>
    </div>
  </Section>

  <Section label="The full catalog" title="What are you trying to do?" id="catalog">
    <p class="catalog-intro">These {roadmapCount} workflow examples across ten categories are topics for discovery. Listing a workflow does not mean it is connected, deployed or already proven for your business.</p>
    <p class="start-nudge">Choose one task to discuss, or <a href={walk.path}>tell your business story through the Walk</a>. The free website source does not depend on buying further help.</p>
    <!-- Filter bar: progressive enhancement only. Hidden until the script
         below wires it up; without JavaScript the category sections render
         expanded and readable, so nothing is lost. -->
    <div class="browse-bar" data-filter-ui hidden>
      <label class="visually-hidden" for="catalog-search">Search workflows</label>
      <input
        id="catalog-search"
        class="browse-search"
        type="search"
        placeholder="Search workflows…"
        autocomplete="off"
      />
      {/* Exactly one filter is active at a time, so these are radios, not
          independent toggles — with the roving-tabindex arrow-key pattern. */}
      <div class="chips" role="radiogroup" aria-label="Filter by category">
        <button
          type="button"
          class="chip is-active"
          role="radio"
          aria-checked="true"
          tabindex="0"
          data-chip="all"
        >
          All
        </button>
        {
          roadmap.map((category) => (
            <button
              type="button"
              class="chip"
              role="radio"
              aria-checked="false"
              tabindex="-1"
              data-chip={category.slug}
            >
              {category.name}
            </button>
          ))
        }
      </div>
    </div>

    {/* Permanently in the accessibility tree (never [hidden]) so screen
        readers hear every filter change, including "no matches". One line
        of height is always reserved, so appearing text causes no shift. */}
    <p class="browse-count" data-count aria-live="polite"></p>

    <div class="cats">
      {
        roadmap.map((category) => (
          <section class="cat" id={category.slug} data-cat={category.slug}>
            <div class="cat-row" data-cat-row>
              <span class="cat-head">
                <h3 class="cat-name">
                  <button
                    type="button"
                    class="cat-trigger"
                    id={`cat-trigger-${category.slug}`}
                    aria-controls={`cat-panel-${category.slug}`}
                    aria-expanded="true"
                  >
                    {category.name}
                  </button>
                </h3>
                <span class="cat-desc">Workflow discovery topics</span>
              </span>
              <span class="cat-meta">
                <span class="cat-count">
                  {category.items.length}
                  <span class="visually-hidden"> workflows</span>
                </span>
                <span class="cat-chevron" aria-hidden="true" />
              </span>
            </div>
            <div
              class="cat-panel"
              id={`cat-panel-${category.slug}`}
              role="region"
              aria-labelledby={`cat-trigger-${category.slug}`}
            >
              <ul class="cat-list" role="list">
                {category.items.map((item) => (
                  <li class="cat-item" data-item>
                    {item.slug ? (
                      <a class="cat-link" href={`/services/${item.slug}/`}>
                        {item.name}
                        <span aria-hidden="true"> &rarr;</span>
                      </a>
                    ) : (
                      <p class="cat-item-name">{item.name}</p>
                    )}
                    <p class="cat-blurb">{item.slug === 'website-builder' ? 'Free client-owned HTML and README; hosting is separate.' : 'One-workflow discovery topic; scope and availability need confirmation.'}</p>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        ))
      }
    </div>

    <script is:inline>
      // Collapse the catalog before first paint when JavaScript is available.
      // Without JavaScript this never runs and every category stays expanded
      // and readable — the progressive-enhancement fallback.
      (function () {
        document.querySelectorAll('#catalog .cat-panel').forEach(function (p) {
          p.hidden = true;
        });
        document.querySelectorAll('#catalog .cat-trigger').forEach(function (b) {
          b.setAttribute('aria-expanded', 'false');
        });
      })();
    </script>

    <p class="browse-empty" data-empty hidden>
      Nothing matches that.
      <button type="button" class="browse-reset" data-reset>Show everything</button>
      — or <a href={walk.path}>begin the walk</a> and let your read point you.
    </p>
  </Section>

  <Section label="Further help" title="Agree the next step separately.">
    <div class="prose">
      <p>The free website source files are yours to keep. Hosting, domain renewal, maintenance and further edits are separate arrangements.</p>
      <p>Discovery starts with one workflow and a clear result. Any implementation, AI lead pilot or paid engagement needs a written scope and separately accepted terms before work or activation begins.</p>
    </div>
  </Section>

  <Section label="The point">
    <p class="lede">
      The client paying our smallest fee gets exactly the same care as the client paying
      our largest — that isn't a promotion, it's the entire point.
    </p>
  </Section>

  <Section label="Next step">
    <nav class="cta-row" aria-label="Get started">
      <Button href={walk.path}>Begin the walk</Button>
      <Button href="/contact/" variant="ghost">Ask a question</Button>
    </nav>
  </Section>

  <script>
    // Catalog browse: disclosure toggles, filter chips, and search.
    // Progressive enhancement — the markup is complete without this script
    // (the inline snippet above collapses the panels only when JS runs).
    // State changes only toggle `hidden`/aria attributes: no DOM rebuilding.
    const ui = document.querySelector<HTMLElement>('[data-filter-ui]');
    const search = document.getElementById('catalog-search') as HTMLInputElement | null;
    const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-chip]')];
    const cats = [...document.querySelectorAll<HTMLElement>('section[data-cat]')];
    const countEl = document.querySelector<HTMLElement>('[data-count]');
    const emptyEl = document.querySelector<HTMLElement>('[data-empty]');
    const resetEl = document.querySelector<HTMLButtonElement>('[data-reset]');

    if (ui && search && countEl && emptyEl && cats.length) {
      ui.hidden = false;
      let activeChip = 'all';
      let lastQuery = '';

      const norm = (s: string) => s.toLowerCase();
      const triggerOf = (cat: HTMLElement) =>
        cat.querySelector<HTMLButtonElement>('.cat-trigger');

      function setOpen(cat: HTMLElement, open: boolean) {
        const trigger = triggerOf(cat);
        const panel = cat.querySelector<HTMLElement>('.cat-panel');
        if (!trigger || !panel) return;
        trigger.setAttribute('aria-expanded', String(open));
        panel.hidden = !open;
        cat.toggleAttribute('data-open', open);
      }

      // driveOpen: true when a filter/search change should decide which
      // categories are open. Manual toggles are never overridden outside
      // of these calls.
      function apply(driveOpen: boolean) {
        const q = norm(search!.value.trim());
        let shown = 0;
        let total = 0;

        for (const cat of cats) {
          const inChip = activeChip === 'all' || cat.dataset.cat === activeChip;
          // A query matching the category's own name/descriptor matches the
          // whole category — searching "legal" must surface Legal itself.
          const rowText = norm(cat.querySelector('.cat-row')?.textContent || '');
          const catMatch = q !== '' && rowText.includes(q);
          const items = [...cat.querySelectorAll<HTMLElement>('[data-item]')];
          total += items.length;
          let visible = 0;
          for (const item of items) {
            const match =
              inChip && (!q || catMatch || norm(item.textContent || '').includes(q));
            item.hidden = !match;
            if (match) visible += 1;
          }
          shown += visible;
          cat.hidden = !inChip || (q !== '' && visible === 0);
          if (driveOpen) {
            if (q !== '') setOpen(cat, visible > 0);
            else if (activeChip !== 'all') setOpen(cat, inChip);
            else setOpen(cat, false);
          }
        }

        const filtering = q !== '' || activeChip !== 'all';
        countEl!.textContent = !filtering
          ? ''
          : shown === 0
            ? 'No workflows match'
            : `Showing ${shown} of ${total} workflows`;
        emptyEl!.hidden = shown > 0;
      }

      function selectChip(next: HTMLButtonElement) {
        activeChip = next.dataset.chip!;
        chips.forEach((c) => {
          const on = c === next;
          c.classList.toggle('is-active', on);
          c.setAttribute('aria-checked', String(on));
          c.tabIndex = on ? 0 : -1;
        });
      }

      function resetFilters() {
        search!.value = '';
        lastQuery = '';
        selectChip(chips.find((c) => c.dataset.chip === 'all')!);
        apply(true);
      }

      search.addEventListener('input', () => {
        const q = norm(search!.value.trim());
        if (q === lastQuery) return; // no-op (e.g. spaces): keep manual state
        lastQuery = q;
        apply(true);
      });

      chips.forEach((chip, i) => {
        chip.addEventListener('click', () => {
          if (chip.dataset.chip === activeChip) return; // no-op: keep manual state
          selectChip(chip);
          apply(true);
        });
        // Radiogroup arrow-key pattern (selection follows focus).
        chip.addEventListener('keydown', (e) => {
          const delta =
            e.key === 'ArrowRight' || e.key === 'ArrowDown'
              ? 1
              : e.key === 'ArrowLeft' || e.key === 'ArrowUp'
                ? -1
                : 0;
          if (!delta) return;
          e.preventDefault();
          const next = chips[(i + delta + chips.length) % chips.length];
          next.focus();
          next.click();
        });
      });

      resetEl?.addEventListener('click', () => {
        resetFilters();
        search!.focus();
      });

      // Disclosure toggles: the trigger button carries the semantics;
      // clicking anywhere on the row toggles too.
      for (const cat of cats) {
        const trigger = triggerOf(cat);
        trigger?.addEventListener('click', () => {
          setOpen(cat, trigger.getAttribute('aria-expanded') !== 'true');
        });
        cat.querySelector('[data-cat-row]')?.addEventListener('click', (e) => {
          if ((e.target as Element).closest('.cat-trigger')) return;
          trigger?.click();
        });
      }

      // Deep links (/services/#legal, e.g. from older anchors) open that
      // category, clearing any filter that would hide it. getElementById on
      // the decoded fragment — never a CSS selector, so junk hashes
      // (#utm_source=…, #%20) cannot throw.
      const openFromHash = () => {
        const raw = location.hash.slice(1);
        if (!raw) return;
        let id = raw;
        try {
          id = decodeURIComponent(raw);
        } catch {
          /* keep the raw fragment */
        }
        const target = document.getElementById(id);
        if (!target || !target.matches('section[data-cat]')) return;
        if (search!.value !== '' || activeChip !== 'all') resetFilters();
        setOpen(target, true);
      };
      openFromHash();
      window.addEventListener('hashchange', openFromHash);
    }
  </script>
</BaseLayout>

<style>
  /* ---- The flow: one numbered journey, not a menu ---- */
  .flow {
    list-style: none;
    max-width: 50rem;
    display: grid;
    gap: 0;
    margin-top: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .fstage {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-md);
    padding: 1.125rem 0;
    border-top: var(--border-hairline);
  }

  .fstage:first-child {
    border-top: none;
  }

  .fstage-num {
    font-family: var(--font-mono);
    font-weight: var(--weight-mono-medium);
    font-size: var(--text-caption);
    color: var(--color-steel);
    padding-top: 0.3125rem;
  }

  .fstage-name {
    font-size: var(--text-h3);
    line-height: var(--leading-heading);
    color: var(--color-ink);
    margin-bottom: 0.375rem;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .fstage-name a {
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .fstage-name a:hover {
    color: var(--color-steel);
    border-bottom-color: var(--color-steel);
  }

  .fstage-tag {
    font-family: var(--font-mono);
    font-size: var(--text-tag);
    font-weight: var(--weight-mono);
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    color: var(--color-steel);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    padding: 0.125rem 0.625rem;
  }

  .fstage-blurb {
    font-size: var(--text-body-sm);
    line-height: var(--leading-tight);
    color: var(--color-body);
    max-width: 62ch;
  }

  @media (max-width: 640px) {
    .fstage {
      grid-template-columns: 1fr;
      gap: 0.375rem;
    }
  }

  /* ---- The full catalog: category-first, collapsed by default ----
     The categories do the organizing; workflows appear on expand. Kept
     deliberately lighter than the staffed catalog above — hairline rows,
     Stone-weighted type, no panel cards — so the flagship still outranks it. */
  .catalog-intro {
    max-width: var(--width-measure);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-body-strong);
    margin-bottom: var(--space-sm);
  }

  /* The honesty caveat: lighter than the lede above it. */
  .catalog-intro--minor {
    font-size: var(--text-body-sm);
    color: var(--color-body);
  }

  .start-nudge {
    max-width: var(--width-measure);
    font-size: var(--text-body-sm);
    color: var(--color-body);
    margin-top: var(--space-md);
  }

  /* ---- Filter bar ---- */
  .browse-bar {
    display: grid;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  /* `display: grid` above would defeat the UA's [hidden] rule — restate it,
     or the pre-JS "hidden" bar renders as a dead control panel. */
  .browse-bar[hidden] {
    display: none;
  }

  .browse-search {
    max-width: 22rem;
    background: var(--color-paper);
    border: var(--border-hairline);
    border-radius: var(--radius-swatch);
    padding: 0.625rem 0.875rem;
    /* 16px minimum: anything smaller triggers iOS Safari's focus zoom. */
    font-size: 1rem;
    color: var(--color-ink);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .browse-search::placeholder {
    color: var(--color-stone);
  }

  .browse-search:focus {
    border-color: var(--color-steel);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .chip {
    font-family: var(--font-mono);
    font-size: var(--text-tag);
    font-weight: var(--weight-mono);
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    color: var(--color-stone);
    background: transparent;
    border: var(--border-hairline);
    border-radius: var(--radius-pill);
    padding: 0.375rem 0.75rem;
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out);
  }

  .chip:hover {
    color: var(--color-ink);
    border-color: var(--color-stone);
  }

  /* Selected chip: Ink on the warm neutral tint (same selected language as
     the diagnostic options — never the amber wash). */
  .chip.is-active {
    color: var(--color-ink);
    border-color: var(--color-ink);
    background: var(--color-track);
  }

  /* A figure line, so mono + Steel. One line of height is reserved even when
     empty, so the count appearing/disappearing never shifts the layout. */
  .browse-count {
    font-family: var(--font-mono);
    font-size: var(--text-tag);
    font-weight: var(--weight-mono);
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    color: var(--color-steel);
    margin-top: var(--space-sm);
    min-height: 1rem;
  }

  /* ---- Category disclosures ----
     Not <details>: a button-in-heading disclosure keeps the ten category
     names reachable by screen-reader heading navigation (VoiceOver strips
     heading semantics inside <summary>), and the no-JS fallback renders
     everything expanded. */
  .cats {
    margin-top: var(--space-xs);
    border-top: var(--border-hairline);
  }

  .cat {
    border-bottom: var(--border-hairline);
    /* Offset sticky-header height so anchor jumps land cleanly. */
    scroll-margin-top: 5rem;
  }

  .cat-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: 1.125rem 0;
    cursor: pointer;
  }

  .cat-head {
    display: grid;
    gap: 0.3125rem;
  }

  .cat-name {
    font-size: var(--text-h3);
    line-height: var(--leading-heading);
  }

  /* The disclosure trigger inherits the serif heading look. */
  .cat-trigger {
    font: inherit;
    color: var(--color-ink);
    background: none;
    border: none;
    padding: 0;
    text-align: left;
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .cat-row:hover .cat-trigger {
    color: var(--color-steel);
  }

  .cat-desc {
    font-size: var(--text-body-sm);
    line-height: var(--leading-tight);
    color: var(--color-body);
    max-width: 52ch;
  }

  .cat-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex: none;
  }

  /* The count: a figure, so mono + Steel. */
  .cat-count {
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-mono);
    color: var(--color-steel);
  }

  .cat-chevron {
    display: block;
    width: 7px;
    height: 7px;
    border-right: 1.5px solid var(--color-stone);
    border-bottom: 1.5px solid var(--color-stone);
    transform: rotate(45deg) translate(-1px, -1px);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .cat[data-open] .cat-chevron {
    transform: rotate(-135deg) translate(-1px, -1px);
  }

  .cat-list {
    list-style: none;
    padding-bottom: var(--space-md);
  }

  .cat-item {
    padding: 0.75rem 0;
  }

  .cat-item + .cat-item {
    border-top: var(--border-hairline);
  }

  /* Filtered-out rows are display:none but still siblings — don't let the
     first visible row inherit a stray separator from a hidden predecessor. */
  .cat-item[hidden] + .cat-item {
    border-top: none;
  }

  .cat-item-name {
    font-weight: var(--weight-body-medium);
    font-size: var(--text-body-sm);
    color: var(--color-ink);
  }

  /* Linkable item name — understated (Steel accent, not a button). */
  .cat-link {
    display: inline-block;
    font-weight: var(--weight-body-medium);
    font-size: var(--text-body-sm);
    text-decoration: none;
    color: var(--color-ink);
    border-bottom: 1px solid transparent;
    transition: color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .cat-link span {
    color: var(--color-steel);
  }

  .cat-link:hover {
    color: var(--color-steel);
    border-bottom-color: var(--color-steel);
  }

  .cat-blurb {
    font-size: var(--text-caption);
    line-height: var(--leading-tight);
    color: var(--color-body);
    margin-top: 0.25rem;
    max-width: 62ch;
  }

  .browse-empty {
    margin-top: var(--space-md);
    font-size: var(--text-body-sm);
    color: var(--color-body);
    max-width: var(--width-measure);
  }

  .browse-reset {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font: inherit;
    color: var(--color-steel);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-steel) 40%, transparent);
    text-underline-offset: 3px;
  }

  .browse-reset:hover {
    text-decoration-color: var(--color-steel);
  }

  @media (max-width: 760px) {
    .cat-row {
      gap: var(--space-sm);
    }
  }

  /* ---- How engagements run ---- */
  .prose {
    max-width: var(--width-measure);
  }

  .prose p {
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-body-strong);
  }

  .prose p + p {
    margin-top: var(--space-sm);
  }

  /* ---- Same care at every price: serif lede pull quote ---- */
  .lede {
    font-family: var(--font-display);
    font-weight: var(--weight-body-medium);
    font-size: var(--text-lede);
    line-height: var(--leading-lede);
    color: var(--color-ink);
    max-width: 44rem;
  }

  /* ---- CTA row ---- */
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: center;
    margin-top: var(--space-2xs);
  }
</style>
